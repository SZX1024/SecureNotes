{
  "name": "securenotes",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal, local-first, client-side-encrypted memo PWA on Cloudflare Workers + D1 + R2",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:worker": "pnpm --filter @securenotes/worker dev",
    "dev:web": "pnpm --filter @securenotes/web dev",
    "build": "pnpm --filter @securenotes/web build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:version": "node scripts/check-version.mjs",
    "check": "pnpm check:version && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "playwright-core": "^1.63.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1"
  }
}
