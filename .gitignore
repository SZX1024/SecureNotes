# dependencies
node_modules/
# only used when a machine-local pnpm store is redirected into the repository
.pnpm-store/

# build output
dist/
.vite/
*.tsbuildinfo

# Cloudflare / wrangler local state (contains local D1 + R2 data)
.wrangler/

# Throwaway HOME used when the machine's real $HOME is not writable
# (wrangler writes ~/.config/.wrangler). See README "Running locally".
.sandbox-home/

# local secrets — never commit
.dev.vars
.dev.vars.*
!.dev.vars.example
.env
.env.*
!.env.example

# test + tooling output
coverage/
playwright-report/
test-results/

# editor / OS
.DS_Store
Thumbs.db
*.log
